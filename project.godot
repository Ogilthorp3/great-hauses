; Engine configuration file.
; Great Hauses — gritty medieval battle chess.

config_version=5

[application]

config/name="Great Hauses Chess"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/branding/app-icon-1024.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
; visionOS-only: boot_splash/show_image is a GLOBAL key and applies to every
; platform if set bare — the spec puts desktop boot-splash behaviour
; explicitly out of scope, so this is feature-tagged to visionOS alone
; (2026-08-10 review, final gate). Windows/macOS keep the engine default.
boot_splash/show_image.visionos=false

[autoload]

PieceAssets="*res://src/board/piece_assets.gd"
Music="*res://src/audio/music_manager.gd"
; E2EDriver is NOT an autoload: the harness must not ship (see
; src/main.gd::_install_e2e_harness). It is registered at runtime, only for a
; --e2e launch, and release exports exclude test_e2e/** entirely.

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode="fullscreen"
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(0.02, 0.02, 0.02, 1)
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
vrs/mode=0
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[xr]

; Multiview shader variants are compiled ONLY when this is true
; (scene_shader_forward_mobile.cpp:625-627 gates enable_multiview_shader_group()
; on it) — it defaults to false (rendering_server.cpp:3816). The Mobile
; renderer this project is pinned to has NO lazy fallback for a missing
; multiview variant (render_forward_mobile.cpp:1033-1035); Clustered has one
; (render_forward_clustered.cpp:1888-1892) but visionOS immersive only
; supports Mobile. Leaving this false ships a build that passes every other
; gate and cannot render a stereo frame. tools/build/assert_visionos_preset.py
; asserts this key so a future removal fails the build instead of the headset.
shaders/enabled=true
