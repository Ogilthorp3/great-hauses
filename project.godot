; Engine configuration file.
; Great Hauses — gritty medieval battle chess.

config_version=5

[application]

config/name="Great Hauses Chess"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/branding/app-icon-1024.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
; visionOS-only: boot_splash/show_image is a GLOBAL key and applies to every
; platform if set bare — the spec puts desktop boot-splash behaviour
; explicitly out of scope, so this is feature-tagged to visionOS alone
; (2026-08-10 review, final gate). Windows/macOS keep the engine default.
boot_splash/show_image.visionos=false

[autoload]

Diag="*res://src/diag/diagnostic_logger.gd"
PieceAssets="*res://src/board/piece_assets.gd"
Music="*res://src/audio/music_manager.gd"
; E2EDriver is NOT an autoload: the harness must not ship (see
; src/main.gd::_install_e2e_harness). It is registered at runtime, only for a
; --e2e launch, and release exports exclude test_e2e/** entirely.

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode="fullscreen"
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; iPad: this game is a board seen from a seat — it has no portrait layout, and
; the HUD is laid out for a wide frame. Sensor landscape so either way up
; works when the player picks the tablet off a table.
;
; THIS KEY LIVES IN THE EXISTING [display] SECTION ON PURPOSE. Godot's own
; parser merges a second [display] block quite happily, so a duplicate looks
; harmless in the editor and in game — but tools/build/assert_visionos_preset.py
; reads project.godot with Python's configparser, which raises
; DuplicateSectionError and takes the whole visionOS build down with it. The
; engine's tolerance is not the contract; the strictest reader is.
window/handheld/orientation="sensor_landscape"

[audio]

; iOS SILENCES "Ambient" AUDIO WITH THE MUTE SWITCH. Godot's default session
; category is 0 = Ambient, which is correct for an app that should duck to
; the user's music and respect the ring/silent switch — and wrong for a game
; whose score, duel stings and dragon roar ARE the experience. Albert played
; the first TestFlight build and heard nothing at all.
; 3 = Playback: audio plays regardless of the mute switch, which is what
; every game on the store does.
general/ios/session_category=3

[input_devices]

; Explicit rather than relying on the engine default: a tap MUST arrive as a
; left click, because that is the only way the board is played on glass.
pointing/emulate_mouse_from_touch=true

[rendering]

environment/defaults/default_clear_color=Color(0.02, 0.02, 0.02, 1)
renderer/rendering_method="mobile"
renderer/rendering_method.windows="forward_plus"
renderer/rendering_method.macos="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
vrs/mode=0
; 2D MSAA is OFF: the engine itself reports "2D MSAA is enabled while there
; is no 2D content" on every frame of a perf run. This project's 2D is HUD
; text and rects, which take nothing from multisampling, and on an iPad at
; native resolution the resolve is pure bandwidth for no pixels. 3D MSAA
; stays at 4x — the gothic tracery is all thin diagonal edges and it is the
; one place multisampling earns its cost.
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[xr]

; Multiview shader variants are compiled ONLY when this is true
; (scene_shader_forward_mobile.cpp:625-627 gates enable_multiview_shader_group()
; on it) — it defaults to false (rendering_server.cpp:3816). The Mobile
; renderer this project is pinned to has NO lazy fallback for a missing
; multiview variant (render_forward_mobile.cpp:1033-1035); Clustered has one
; (render_forward_clustered.cpp:1888-1892) but visionOS immersive only
; supports Mobile. Leaving this false ships a build that passes every other
; gate and cannot render a stereo frame. tools/build/assert_visionos_preset.py
; asserts this key so a future removal fails the build instead of the headset.
shaders/enabled=true
shaders/enabled.windows=false
shaders/enabled.macos=false

